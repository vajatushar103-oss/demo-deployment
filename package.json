{
  "name": "prime-machines",
  "private": true,
  "version": "1.0.0",
  "description": "PRIME Machines website - React, Tailwind CSS, Express and MongoDB",
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:client": "npm --prefix client run dev",
    "dev:server": "npm --prefix server run dev",
    "build": "npm --prefix client run build",
    "start": "npm --prefix server run start",
    "seed": "npm --prefix server run seed",
    "install:all": "npm install && npm --prefix client install && npm --prefix server install"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  },
  "dependencies": {
    "@netlify/functions": "^6.0.0",
    "axios": "^1.20.0",
    "bcryptjs": "^3.0.3",
    "jsonwebtoken": "^9.0.3",
    "nodemon": "^3.1.14",
    "react-router": "^8.4.0",
    "serverless-http": "^4.0.0"
  }
}
